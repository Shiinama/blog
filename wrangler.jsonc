{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "blog",
	"main": "worker.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// esbuild's keepNames injects `__name` into functions that next-themes serialises
	// into an inline <script>, which then throws in the browser.
	"keep_names": false,
	"observability": {
		"logs": { "enabled": true }
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Remote, so `next dev` works against real data. Builds never query it (see lib/db.ts).
	"d1_databases": [
		{
			"binding": "BLOG_DATABASE",
			"database_name": "blog",
			"database_id": "ce73ae09-d75b-4701-99bd-8dda6de6816e",
			"migrations_dir": "./drizzle/migrations",
			"remote": true
		}
	],
	"r2_buckets": [
		{ "binding": "BLOG_BUCKET", "bucket_name": "blog-bucket", "remote": true },
		{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "open-next-cache-blog", "remote": true }
	],
	"images": { "binding": "IMAGES" },
	"queues": {
		"producers": [{ "binding": "AI_DAILY_QUEUE", "queue": "blog-ai-daily" }],
		"consumers": [
			{
				"queue": "blog-ai-daily",
				"max_batch_size": 1,
				"max_batch_timeout": 5,
				"max_retries": 3,
				"retry_delay": 300,
				"max_concurrency": 1,
				"dead_letter_queue": "blog-ai-daily-dlq"
			}
		]
	},
	"services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "blog" }]
}
