{
  "name": "blog",
  "version": "0.1.0",
  "author": "felix",
  "description": "Fish Blog — a bilingual blog on Next.js, Cloudflare Workers and D1",
  "homepage": "https://xibaoyu.xyz",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "deploy:prod": "tsx scripts/deploy/index.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply BLOG_DATABASE --remote",
    "db:migrate:local": "wrangler d1 migrations apply BLOG_DATABASE --local",
    "db:rebuild": "tsx scripts/db/rebuild.ts",
    "db:studio": "drizzle-kit studio",
    "blog": "tsx --env-file-if-exists=.env scripts/blog/cli.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@opennextjs/cloudflare": "^1.20.16",
    "@tiptap/extension-code-block-lowlight": "^3.33.0",
    "@tiptap/extension-highlight": "^3.33.0",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/extension-table": "^3.33.0",
    "@tiptap/markdown": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.70.0",
    "motion": "^14.9.1",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "openai": "^7.52.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yargs": "^17.0.35",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "gray-matter": "^4.0.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "^4.158.0",
    "yargs": "^18.2.0"
  }
}
